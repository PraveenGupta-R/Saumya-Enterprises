# ==============================
# Dependencies
# ==============================
**/node_modules/
**/bower_components/

# ==============================
# Angular / frontend build output and cache
# ==============================
**/.angular/
**/dist/
**/out-tsc/
**/coverage/
**/bazel-out/

# ==============================
# Environment files and secrets
# Keep example templates in Git, but never commit real credentials.
# ==============================
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# ==============================
# Logs and runtime files
# ==============================
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
**/pids/
**/*.pid
**/*.pid.lock

# ==============================
# Build/tool caches and generated files
# ==============================
**/.cache/
**/.sass-cache/
**/.eslintcache
**/.stylelintcache
**/*.tsbuildinfo
**/.wrangler/

# ==============================
# IDEs and editors
# ==============================
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ==============================
# Operating system files
# ==============================
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

# ==============================
# Temporary files and test artifacts
# ==============================
**/tmp/
**/temp/
**/__screenshots__/
testem.log
/connect.lock
