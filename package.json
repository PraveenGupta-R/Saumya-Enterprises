{
  "name": "saumya-enterprises",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "api": "wrangler dev --port 8787",
    "seed:gen": "node scripts/gen-seed.mjs",
    "db:init": "wrangler d1 migrations apply saumya-enterprises --local && node scripts/gen-seed.mjs && wrangler d1 execute saumya-enterprises --local --file worker/seed.sql",
    "db:init:remote": "wrangler d1 migrations apply saumya-enterprises --remote && node scripts/gen-seed.mjs && wrangler d1 execute saumya-enterprises --remote --file worker/seed.sql",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "deploy": "ng build && wrangler deploy",
    "test": "ng test",
    "serve:ssr:saumya-enterprises": "node dist/saumya-enterprises/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.7",
    "express": "^5.1.0",
    "hono": "^4.13.19",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.7",
    "@angular/cli": "^20.3.7",
    "@angular/compiler-cli": "^20.3.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.166.0"
  }
}
